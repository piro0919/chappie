{
  "name": "chappie-desktop",
  "private": true,
  "version": "0.23.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "scripts/dev-local.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest",
    "test:run": "vitest run",
    "test:golden": "bash scripts/run-golden.sh",
    "test:multi-turn": "node scripts/test-tool-routing.mjs",
    "dmg": "bash scripts/build-dmg.sh",
    "release": "pnpm dmg && pnpm release:create && pnpm release:upload",
    "release:create": "gh release create v$npm_package_version -t \"Release v$npm_package_version\" --generate-notes",
    "release:generate-latest": "node -e \"const fs=require('fs');const v=process.env.npm_package_version;const sig=fs.readFileSync('src-tauri/target/release/bundle/macos/Chappie.app.tar.gz.sig','utf8').trim();const json={version:v,notes:'',pub_date:new Date().toISOString(),platforms:{'darwin-aarch64':{signature:sig,url:'https://github.com/piro0919/chappie/releases/download/v'+v+'/Chappie.app.tar.gz'}}};fs.writeFileSync('latest.json',JSON.stringify(json,null,2))\"",
    "release:upload": "pnpm release:generate-latest && gh release upload v$npm_package_version \"src-tauri/target/release/bundle/dmg/Chappie_${npm_package_version}_aarch64.dmg\" \"src-tauri/target/release/bundle/macos/Chappie.app.tar.gz\" \"src-tauri/target/release/bundle/macos/Chappie.app.tar.gz.sig\" latest.json --clobber"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.11.6",
    "lefthook": "^2.1.10",
    "secretlint": "^13.0.4",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
