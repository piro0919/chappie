{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chappie",
  "version": "0.1.0",
  "identifier": "io.kkweb.chappie",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chappie",
        "width": 320,
        "height": 200,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.openai.com; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "ハンズフリー音声AIアシスタント",
    "longDescription": "ウェイクワード「チャッピー」で起動し、声だけで会話できるトレイ常駐型のデスクトップAIアシスタント。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
