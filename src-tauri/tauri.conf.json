{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chappie",
  "version": "0.5.0",
  "identifier": "io.kkweb.chappie",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Chappie デバッグ",
        "width": 480,
        "height": 480,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Hands-free voice AI assistant",
    "longDescription": "A tray-only desktop AI assistant. Say 'chappie' to wake it up and have a fully voice-driven conversation with no keyboard or mouse.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQkI1QzQ4MzlFRjM1NDkKUldSSk5lODVTRnk3VTBwMlh4TU83Z3VLOVFhblRncWJLOEVPRG1jUjhrbnd0UHEwdnpaWHdUeFgK",
      "endpoints": [
        "https://github.com/piro0919/chappie/releases/latest/download/latest.json"
      ]
    }
  }
}
