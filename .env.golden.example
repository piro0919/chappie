# Copy to `.env.golden` and fill in the keys you actually have.
# `.env.golden` is gitignored. Run `chmod 600 .env.golden` after editing.
# The test skips any provider whose key is missing, so partial setup is fine.

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
